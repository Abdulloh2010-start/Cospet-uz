rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }

    match /products/{id} { allow read: if true; allow write: if isAdmin(); }

    match /orders/{id} {
      // Заказ может оформить любой; uid можно указать только свой.
      allow create: if request.resource.data.status == 'new' && request.resource.data.items.size() > 0
        && (request.resource.data.get('uid', null) == null || (request.auth != null && request.auth.uid == request.resource.data.uid));
      allow read: if isAdmin() || (request.auth != null && resource.data.get('uid', null) == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /reviews/{rid} {
      allow read: if true;
      // Отзыв — только на купленные часы: заказ принадлежит автору, отправлен/выполнен и содержит этот товар.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && rid == request.resource.data.orderId + '_' + request.resource.data.productId
        && get(/databases/$(db)/documents/orders/$(request.resource.data.orderId)).data.get('uid', null) == request.auth.uid
        && get(/databases/$(db)/documents/orders/$(request.resource.data.orderId)).data.status in ['shipped', 'done']
        && request.resource.data.productId in get(/databases/$(db)/documents/orders/$(request.resource.data.orderId)).data.productIds;
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow update: if false;
    }

    match /admins/{uid} { allow read: if request.auth != null && request.auth.uid == uid; }
  }
}
